# Secrets lus par docker-compose.yml (substitution ${TOA_*}).
# Ils vivent dans le fichier .env du serveur (non versionné, chmod 640, groupe www-data).
# Générés et appliqués par docker/rotate-secrets.sh ; à défaut : openssl rand -hex 32
TOA_APP_SECRET=
TOA_JWT_PASSPHRASE=
TOA_MERCURE_SECRET=
TOA_MINIO_ROOT_USER=
TOA_MINIO_ROOT_PASSWORD=
TOA_DB_PASSWORD=
