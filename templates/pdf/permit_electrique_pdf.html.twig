<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Permis de Travail Électrique — {{ permit.reference }}</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: Arial, Helvetica, sans-serif; font-size: 10pt; color: #1a1a1a; background: #fff; }
    @page { size: A4; margin: 20mm 15mm 20mm 15mm; }

    .watermark {
      position: fixed; top: 0; left: 0; width: 100%; height: 100%;
      display: flex; align-items: center; justify-content: center;
      z-index: -1; pointer-events: none;
    }
    .watermark span {
      font-size: 90pt; font-weight: 900; color: rgba(255, 165, 0, 0.07);
      transform: rotate(-45deg); white-space: nowrap; letter-spacing: 6px;
      text-transform: uppercase;
    }

    .page-header {
      display: flex; align-items: center; justify-content: space-between;
      border-bottom: 3px solid #cc8800; padding-bottom: 10px; margin-bottom: 16px;
    }
    .logo-area { display: flex; align-items: center; gap: 10px; }
    .logo-img { height: 48px; width: auto; }
    .doc-title { text-align: right; }
    .doc-title h1 { font-size: 13pt; font-weight: 900; color: #cc8800; text-transform: uppercase; }
    .doc-title .subtitle { font-size: 8pt; color: #555; margin-top: 2px; }

    .reference-banner {
      background: #cc8800; color: #fff; padding: 10px 16px;
      border-radius: 6px; margin-bottom: 14px;
      display: flex; align-items: center; justify-content: space-between;
    }
    .reference-banner .ref { font-size: 14pt; font-weight: 900; letter-spacing: 1px; }
    .type-badge {
      background: #fff; color: #cc8800; border-radius: 4px;
      padding: 4px 12px; font-size: 9pt; font-weight: 700; text-transform: uppercase;
    }

    .section { margin-bottom: 16px; }
    .section-title {
      background: #fff8e1; border-left: 4px solid #cc8800;
      padding: 5px 10px; font-size: 10pt; font-weight: 700; color: #cc8800;
      margin-bottom: 8px; text-transform: uppercase;
    }

    .info-grid { display: table; width: 100%; border-collapse: collapse; }
    .info-row { display: table-row; }
    .info-label {
      display: table-cell; width: 32%; background: #f5f5f5;
      border: 1px solid #ddd; padding: 4px 8px; font-weight: 600; font-size: 9pt;
      vertical-align: top;
    }
    .info-value { display: table-cell; border: 1px solid #ddd; padding: 4px 8px; font-size: 9pt; vertical-align: top; }

    table { width: 100%; border-collapse: collapse; font-size: 9pt; }
    th { background: #cc8800; color: #fff; padding: 5px 6px; text-align: left; font-size: 8.5pt; font-weight: 700; }
    td { border: 1px solid #ccc; padding: 4px 6px; vertical-align: top; }
    tr:nth-child(even) td { background: #f9f9f9; }

    .warning-box {
      background: #fff3cd; border: 2px solid #ffc107; border-radius: 6px;
      padding: 10px 14px; margin-bottom: 14px;
    }
    .warning-box .warning-title { font-weight: 700; color: #856404; font-size: 10pt; margin-bottom: 4px; }

    .signature-block {
      border: 1px solid #ccc; border-radius: 4px; padding: 10px 14px; background: #fffdf0;
    }
    .sig-label { font-size: 8pt; color: #555; margin-bottom: 2px; }
    .sig-hash {
      font-family: monospace; font-size: 8pt; color: #333;
      word-break: break-all; background: #eee; padding: 3px 6px; border-radius: 3px;
    }
    .sig-grid { display: flex; gap: 20px; flex-wrap: wrap; margin-top: 8px; }
    .sig-item { flex: 1; min-width: 160px; }

    .page-footer {
      position: fixed; bottom: 0; left: 0; right: 0;
      border-top: 1px solid #cc8800; padding: 4px 15mm;
      display: flex; justify-content: space-between; align-items: center;
      font-size: 7.5pt; color: #555; background: #fff;
    }
    .footer-ref { font-weight: 700; color: #cc8800; }
    .page-break { page-break-before: always; }
  </style>
</head>
<body>

  <div class="watermark"><span>VALIDÉ HSE</span></div>

  <div class="page-footer">
    <span class="footer-ref">{{ permit.reference }}</span>
    <span>Permis de Travail ÉLECTRIQUE — CONFIDENTIEL</span>
    <span>Généré le {{ generatedAt|date('d/m/Y à H:i') }}</span>
  </div>

  <!-- EN-TÊTE -->
  <div class="page-header">
    <div class="logo-area">
      {% if logoBase64 %}
        <img src="data:image/png;base64,{{ logoBase64 }}" alt="TOA" class="logo-img">
      {% else %}
        <div style="width:48px;height:48px;background:#cc8800;border-radius:6px;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:900;font-size:14pt;">TOA</div>
      {% endif %}
      <div>
        <div style="font-weight:900;font-size:11pt;color:#cc8800;">TowerCo of Africa</div>
        <div style="font-size:8pt;color:#555;">Direction HSSES</div>
      </div>
    </div>
    <div class="doc-title">
      <h1>Permis de Travail Électrique</h1>
      <div class="subtitle">Document officiel — Usage interne</div>
    </div>
  </div>

  <!-- REFERENCE BANNER -->
  <div class="reference-banner">
    <span class="ref">{{ permit.reference }}</span>
    <span class="type-badge">⚡ Électrique</span>
  </div>

  <!-- AVERTISSEMENT RISQUE ÉLECTRIQUE -->
  <div class="warning-box">
    <div class="warning-title">⚠ Risque électrique — Précautions obligatoires</div>
    <div style="font-size:9pt;color:#856404;">Ce permis autorise des travaux sur ou à proximité d'installations électriques. Toutes les consignations et déconsignations doivent être réalisées par du personnel habilité.</div>
  </div>

  <!-- INFORMATIONS GÉNÉRALES -->
  <div class="section">
    <div class="section-title">Informations générales</div>
    <div class="info-grid">
      <div class="info-row">
        <div class="info-label">Code site</div>
        <div class="info-value">{{ permit.codeSite }}</div>
      </div>
      <div class="info-row">
        <div class="info-label">Type de permis</div>
        <div class="info-value" style="font-weight:700;color:#cc8800;">Électrique</div>
      </div>
      <div class="info-row">
        <div class="info-label">Processus</div>
        <div class="info-value">{{ permit.processus.value }}</div>
      </div>
      <div class="info-row">
        <div class="info-label">Statut</div>
        <div class="info-value" style="font-weight:700;color:#006633;">{{ permit.statut.value }}</div>
      </div>
      {% if permit.dateDebutPrevue %}
      <div class="info-row">
        <div class="info-label">Date début prévue</div>
        <div class="info-value">{{ permit.dateDebutPrevue|date('d/m/Y H:i') }}</div>
      </div>
      {% endif %}
      {% if permit.dateFinPrevue %}
      <div class="info-row">
        <div class="info-label">Date fin prévue</div>
        <div class="info-value">{{ permit.dateFinPrevue|date('d/m/Y H:i') }}</div>
      </div>
      {% endif %}
      <div class="info-row">
        <div class="info-label">Créé par</div>
        <div class="info-value">{{ permit.createdBy.firstname }} {{ permit.createdBy.name }}</div>
      </div>
      {% if permit.soumisAt %}
      <div class="info-row">
        <div class="info-label">Soumis le</div>
        <div class="info-value">{{ permit.soumisAt|date('d/m/Y à H:i') }}</div>
      </div>
      {% endif %}
    </div>
  </div>

  <!-- DESCRIPTION DES TRAVAUX -->
  {% if permit.descriptionTravaux %}
  <div class="section">
    <div class="section-title">Description des travaux électriques</div>
    <div style="border:1px solid #ddd;padding:8px 10px;font-size:9pt;white-space:pre-wrap;background:#fafafa;">{{ permit.descriptionTravaux }}</div>
  </div>
  {% endif %}

  <!-- DOCUMENTS JOINTS -->
  <div class="section">
    <div class="section-title">Documents joints ({{ permit.documents|length }})</div>
    {% if permit.documents|length > 0 %}
    <table>
      <thead>
        <tr>
          <th>Type de document</th>
          <th>Type MIME</th>
          <th>Date d'upload</th>
        </tr>
      </thead>
      <tbody>
        {% for doc in permit.documents %}
        <tr>
          <td style="font-weight:600;">{{ doc.type.value|replace({'_': ' '}) }}</td>
          <td>{{ doc.mimeType ?? '—' }}</td>
          <td>{{ doc.uploadedAt is defined ? doc.uploadedAt|date('d/m/Y H:i') : '—' }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}
      <p style="font-style:italic;color:#555;padding:6px;">Aucun document joint.</p>
    {% endif %}
  </div>

  <!-- DÉCISION HSE -->
  {% set lastValidation = null %}
  {% for d in permit.decisionsHse %}
    {% if d.decision.value == 'VALIDE' %}{% set lastValidation = d %}{% endif %}
  {% endfor %}

  {% if lastValidation %}
  <div class="section">
    <div class="section-title">Validation HSE</div>
    <div class="signature-block">
      <div class="sig-grid">
        <div class="sig-item">
          <div class="sig-label">Validé par</div>
          <div style="font-weight:700;font-size:10pt;">{{ lastValidation.decidePar.firstname }} {{ lastValidation.decidePar.name }}</div>
        </div>
        <div class="sig-item">
          <div class="sig-label">Date de validation</div>
          <div style="font-weight:700;">{{ lastValidation.decidedAt|date('d/m/Y à H:i') }}</div>
        </div>
        <div class="sig-item">
          <div class="sig-label">Décision</div>
          <div style="font-weight:700;color:#006633;">✓ VALIDÉ HSE</div>
        </div>
      </div>
      <div style="margin-top:10px;">
        <div class="sig-label">Empreinte numérique (SHA-256)</div>
        <div class="sig-hash">{{ lastValidation.signatureElectronique }}</div>
      </div>
      {% if lastValidation.commentaire %}
      <div style="margin-top:8px;">
        <div class="sig-label">Commentaire</div>
        <div style="font-size:9pt;font-style:italic;">{{ lastValidation.commentaire }}</div>
      </div>
      {% endif %}
    </div>
  </div>
  {% endif %}

  <!-- HISTORIQUE DES DÉCISIONS -->
  {% if permit.decisionsHse|length > 0 %}
  <div class="section">
    <div class="section-title">Historique des décisions HSE</div>
    {% for decision in permit.decisionsHse %}
    <div style="border:1px solid {% if decision.decision.value == 'VALIDE' %}#006633{% else %}#dc3545{% endif %};border-radius:4px;padding:8px 12px;margin-bottom:8px;">
      <div style="font-weight:700;font-size:9pt;color:{% if decision.decision.value == 'VALIDE' %}#006633{% else %}#dc3545{% endif %};margin-bottom:4px;">
        {% if decision.decision.value == 'VALIDE' %}✓ Validé{% else %}✗ Refusé{% endif %}
        — {{ decision.decidePar.firstname }} {{ decision.decidePar.name }}
      </div>
      <div style="font-size:8pt;color:#555;">{{ decision.decidedAt|date('d/m/Y à H:i') }}</div>
      {% if decision.commentaire %}
      <div style="margin-top:6px;font-size:9pt;font-style:italic;color:#333;border-left:3px solid #ccc;padding-left:8px;">{{ decision.commentaire }}</div>
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}

</body>
</html>
