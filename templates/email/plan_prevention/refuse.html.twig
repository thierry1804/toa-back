{% extends 'email/layout.html.twig' %}

{% block subject %}[TOA] Plan de Prévention #{{ plan.reference }} refusé{% endblock %}
{% block badge %}Plan de Prévention{% endblock %}

{% block body %}
  <h2 style="margin:0 0 8px;font-size:18px;color:#dc2626;">Plan de Prévention refusé</h2>
  <p style="margin:0 0 24px;color:#6b7280;font-size:13px;">Votre plan a été refusé par l'équipe HSE.</p>

  <p style="margin:0 0 20px;">Bonjour <strong>{{ recipient.firstname }} {{ recipient.name }}</strong>,</p>
  <p style="margin:0 0 24px;">
    Votre Plan de Prévention a été refusé par l'équipe HSE. Veuillez prendre connaissance du motif et corriger votre dossier.
  </p>

  <table width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #e5e7eb;border-radius:6px;margin-bottom:20px;">
    <tr style="background:#f0faf4;">
      <td style="padding:10px 16px;font-size:12px;font-weight:700;color:#006633;text-transform:uppercase;letter-spacing:.5px;border-bottom:1px solid #e5e7eb;" colspan="2">
        Détails du plan
      </td>
    </tr>
    <tr>
      <td style="padding:10px 16px;font-weight:600;color:#374151;border-bottom:1px solid #f3f4f6;width:40%;">Référence</td>
      <td style="padding:10px 16px;border-bottom:1px solid #f3f4f6;"><strong style="color:#006633;">{{ plan.reference }}</strong></td>
    </tr>
    <tr style="background:#fafafa;">
      <td style="padding:10px 16px;font-weight:600;color:#374151;border-bottom:1px solid #f3f4f6;">Site</td>
      <td style="padding:10px 16px;border-bottom:1px solid #f3f4f6;">{{ plan.codeSite }}</td>
    </tr>
    <tr>
      <td style="padding:10px 16px;font-weight:600;color:#374151;">Activité planifiée</td>
      <td style="padding:10px 16px;">{{ plan.activitePlanifiee }}</td>
    </tr>
  </table>

  <table width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #fecaca;border-radius:6px;margin-bottom:24px;">
    <tr style="background:#fef2f2;">
      <td style="padding:10px 16px;font-size:12px;font-weight:700;color:#dc2626;text-transform:uppercase;letter-spacing:.5px;border-bottom:1px solid #fecaca;">
        Motif du refus
      </td>
    </tr>
    <tr>
      <td style="padding:14px 16px;color:#374151;line-height:1.6;">{{ commentaire|nl2br }}</td>
    </tr>
  </table>

  <p style="margin:0 0 24px;color:#374151;">
    Merci de corriger votre plan et de le soumettre à nouveau.
  </p>

  <p style="margin:0 0 8px;color:#6b7280;font-size:13px;">Cordialement,</p>
  <p style="margin:0;font-weight:600;color:#006633;">L'équipe TOA</p>
{% endblock %}
