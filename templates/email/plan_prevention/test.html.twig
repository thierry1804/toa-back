{% extends 'email/layout.html.twig' %}

{% block subject %}[TOA] Test de configuration SMTP{% endblock %}
{% block badge %}Test SMTP{% endblock %}

{% block status_banner %}
<tr>
  <td style="background-color:#f0fdf4;border-bottom:1px solid #bbf7d0;padding:14px 32px;">
    <table cellpadding="0" cellspacing="0" role="presentation">
      <tr>
        <td style="vertical-align:middle;padding-right:10px;">
          <span style="display:inline-block;width:8px;height:8px;background-color:#16a34a;border-radius:50%;"></span>
        </td>
        <td style="vertical-align:middle;">
          <span style="font-size:12px;font-weight:700;color:#15803d;letter-spacing:0.4px;text-transform:uppercase;">
            Configuration SMTP opérationnelle
          </span>
        </td>
      </tr>
    </table>
  </td>
</tr>
{% endblock %}

{% block body %}

  <p style="margin:0 0 6px;font-size:16px;font-weight:700;color:#111827;">Bonjour,</p>
  <p style="margin:0 0 24px;font-size:14px;color:#374151;line-height:1.6;">
    Ce message confirme que le serveur de messagerie TOA est correctement configuré. Les notifications automatiques sont maintenant actives.
  </p>

  <table width="100%" cellpadding="0" cellspacing="0" role="presentation"
         style="border:1px solid #e5e7eb;border-radius:8px;overflow:hidden;margin-bottom:24px;">

    <tr>
      <td colspan="2" style="background-color:#f9fafb;border-bottom:1px solid #e5e7eb;padding:11px 18px;">
        <span style="font-size:11px;font-weight:700;color:#6b7280;letter-spacing:0.6px;text-transform:uppercase;">
          Configuration SMTP
        </span>
      </td>
    </tr>

    <tr>
      <td style="padding:12px 18px;font-size:13px;font-weight:600;color:#374151;width:38%;border-bottom:1px solid #f3f4f6;">Serveur</td>
      <td style="padding:12px 18px;font-size:14px;color:#171717;border-bottom:1px solid #f3f4f6;font-family:'Courier New',Courier,monospace;">{{ host }}</td>
    </tr>
    <tr style="background-color:#fafafa;">
      <td style="padding:12px 18px;font-size:13px;font-weight:600;color:#374151;border-bottom:1px solid #f3f4f6;">Port</td>
      <td style="padding:12px 18px;font-size:14px;color:#171717;border-bottom:1px solid #f3f4f6;font-family:'Courier New',Courier,monospace;">{{ port }} (TLS/STARTTLS)</td>
    </tr>
    <tr>
      <td style="padding:12px 18px;font-size:13px;font-weight:600;color:#374151;border-bottom:1px solid #f3f4f6;">Expéditeur</td>
      <td style="padding:12px 18px;font-size:14px;color:#171717;border-bottom:1px solid #f3f4f6;font-family:'Courier New',Courier,monospace;">{{ from }}</td>
    </tr>
    <tr style="background-color:#fafafa;">
      <td style="padding:12px 18px;font-size:13px;font-weight:600;color:#374151;">Destinataire test</td>
      <td style="padding:12px 18px;font-size:14px;color:#171717;font-family:'Courier New',Courier,monospace;">{{ to }}</td>
    </tr>

  </table>

  <table width="100%" cellpadding="0" cellspacing="0" role="presentation"
         style="background-color:#f0fdf4;border:1px solid #bbf7d0;border-radius:8px;">
    <tr>
      <td style="padding:14px 18px;">
        <p style="margin:0;font-size:13px;color:#15803d;line-height:1.5;">
          Les notifications automatiques — soumission, examen, refus, validation — sont maintenant actives sur cette adresse.
        </p>
      </td>
    </tr>
  </table>

{% endblock %}
