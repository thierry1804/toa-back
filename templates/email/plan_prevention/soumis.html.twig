{% extends 'email/layout.html.twig' %}

{% block subject %}[TOA] Plan de Prévention #{{ plan.reference }} à examiner{% endblock %}
{% block badge %}Plan de Prévention{% endblock %}

{% block body %}
  <h2 style="margin:0 0 8px;font-size:18px;color:#006633;">Plan de Prévention soumis</h2>
  <p style="margin:0 0 24px;color:#6b7280;font-size:13px;">Un nouveau plan requiert votre examen.</p>

  <p style="margin:0 0 20px;">Bonjour <strong>{{ recipient.firstname }} {{ recipient.name }}</strong>,</p>
  <p style="margin:0 0 24px;">
    Le Plan de Prévention suivant a été soumis par le prestataire et requiert votre examen :
  </p>

  <table width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #e5e7eb;border-radius:6px;margin-bottom:24px;">
    <tr style="background:#f0faf4;">
      <td style="padding:10px 16px;font-size:12px;font-weight:700;color:#006633;text-transform:uppercase;letter-spacing:.5px;border-bottom:1px solid #e5e7eb;" colspan="2">
        Détails du plan
      </td>
    </tr>
    <tr>
      <td style="padding:10px 16px;font-weight:600;color:#374151;border-bottom:1px solid #f3f4f6;width:40%;">Référence</td>
      <td style="padding:10px 16px;border-bottom:1px solid #f3f4f6;"><strong style="color:#006633;">{{ plan.reference }}</strong></td>
    </tr>
    <tr style="background:#fafafa;">
      <td style="padding:10px 16px;font-weight:600;color:#374151;border-bottom:1px solid #f3f4f6;">Site</td>
      <td style="padding:10px 16px;border-bottom:1px solid #f3f4f6;">{{ plan.codeSite }}</td>
    </tr>
    <tr>
      <td style="padding:10px 16px;font-weight:600;color:#374151;border-bottom:1px solid #f3f4f6;">Localité</td>
      <td style="padding:10px 16px;border-bottom:1px solid #f3f4f6;">{{ plan.localite }}</td>
    </tr>
    <tr style="background:#fafafa;">
      <td style="padding:10px 16px;font-weight:600;color:#374151;border-bottom:1px solid #f3f4f6;">Activité planifiée</td>
      <td style="padding:10px 16px;border-bottom:1px solid #f3f4f6;">{{ plan.activitePlanifiee }}</td>
    </tr>
    <tr>
      <td style="padding:10px 16px;font-weight:600;color:#374151;border-bottom:1px solid #f3f4f6;">Période</td>
      <td style="padding:10px 16px;border-bottom:1px solid #f3f4f6;">
        {{ plan.dateDebut ? plan.dateDebut|date('d/m/Y') : '—' }} → {{ plan.dateFin ? plan.dateFin|date('d/m/Y') : '—' }}
      </td>
    </tr>
    {% if version is defined %}
    <tr style="background:#fafafa;">
      <td style="padding:10px 16px;font-weight:600;color:#374151;">Version</td>
      <td style="padding:10px 16px;"><span style="background:#006633;color:#fff;padding:2px 10px;border-radius:12px;font-size:12px;">v{{ version }}</span></td>
    </tr>
    {% endif %}
  </table>

  <p style="margin:0 0 8px;color:#6b7280;font-size:13px;">Cordialement,</p>
  <p style="margin:0;font-weight:600;color:#006633;">L'équipe TOA</p>
{% endblock %}
