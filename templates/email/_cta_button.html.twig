{# Bouton CTA deep-link (R-28). Attendu : url, label #}
{% if url %}
<table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="margin:24px 0 8px;">
  <tr>
    <td align="center">
      <a href="{{ url }}"
         style="display:inline-block;background-color:#006633;color:#ffffff;font-size:14px;font-weight:700;text-decoration:none;padding:12px 28px;border-radius:8px;letter-spacing:0.2px;">
        {{ label|default('Ouvrir dans TOA') }}
      </a>
    </td>
  </tr>
  <tr>
    <td align="center" style="padding-top:10px;">
      <p style="margin:0;font-size:11px;color:#9ca3af;line-height:1.4;word-break:break-all;">
        {{ url }}
      </p>
    </td>
  </tr>
</table>
{% endif %}
