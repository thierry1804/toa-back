includes:
    - vendor/phpstan/phpstan-phpunit/extension.neon

parameters:
    level: 6
    paths:
        - bin/
        - config/
        - public/
        - src/
        - tests/
    ignoreErrors:
        # Niveau 6 : typage générique/iterable en PHPDoc (Collection<int, X>, array<string, mixed>…)
        # non renseigné dans le code existant ; à résorber progressivement, pas bloquant.
        - identifier: missingType.generics
        - identifier: missingType.iterableValue
        # Entités Doctrine : propriétés hydratées par l'ORM (ex. ?Uuid $id = null), jamais assignées en code.
        - identifier: property.unusedType
